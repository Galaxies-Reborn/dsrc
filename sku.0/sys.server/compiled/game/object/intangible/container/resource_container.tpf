//
//            Filename:     resource_container
//            Directory:    object/intangible/container
//
//            Description:
//            The server half of the hundred-slot resource store. Holds resource
//            crates and crafted sub-components, and is the container the web
//            dashboard reads and the one a factory draws from.
//
//            Intangible so the datapad will accept it; see the shared template
//            for why a tangible container cannot live there.
//
//            Category:                   container
//            Sub-Category:               resource
//

@base object/intangible/base/intangible_base.iff

@class intangible_object_template 0

@class object_template 5

volume = 1

sharedTemplate = "object/intangible/container/shared_resource_container.iff"
