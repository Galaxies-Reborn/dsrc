// Publish 14.1 live-test adapter.
//
// The canonical isLightsaber object marker exercises the production Jedi
// predicate while the inherited DL44 weapon type, appearance, and arrangement
// remain compatible with both the Publish 14.1 client and NGE-derived server
// slot descriptors. The reversible fixture owns and destroys this object.

@base object/weapon/ranged/pistol/pistol_dl44.iff

@class weapon_object_template 11

@class tangible_object_template 3


@class object_template 10

sharedTemplate = "object/weapon/ranged/pistol/shared_pistol_dl44.iff"

objvars = +["isLightsaber"=1]
